# Copy to .env (never commit it). Every setting has a safe development default; see apps/server/app/core/config.py.
HAJIME_ENV=dev
# PostgreSQL stores finished games. Leave it commented to play without a database (nothing is stored).
# To try it: `docker compose up -d postgres`, then `cd apps/server && uv run alembic upgrade head`, then uncomment.
# HAJIME_DATABASE_URL=postgresql+asyncpg://hajime:hajime@localhost:5432/hajime
# Leave empty to run with in-memory registry and rate limiting (single instance)
HAJIME_REDIS_URL=
HAJIME_SENTRY_DSN=
HAJIME_INSTANCE_ID=local
HAJIME_ALLOWED_ORIGINS=["http://localhost:5173"]
HAJIME_ALLOW_MISSING_ORIGIN=true
HAJIME_TRUST_PROXY_HEADERS=false
