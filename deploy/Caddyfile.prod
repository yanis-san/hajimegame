# Edge of the production stack (deploy/compose.prod.yml). Caddy gets and renews the Let's Encrypt certificate
# for $DOMAIN by itself, redirects HTTP to HTTPS and speaks HTTP/2 and HTTP/3.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Same headers the app sets on its pages, here for every response (static files included).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Metrics are for the operator. They are never served to the Internet (the server also refuses them
	# in production unless HAJIME_METRICS_TOKEN is set and sent).
	@private path /metrics /metrics/*
	respond @private 404

	# The admin interface is for the operator. Its address is ADMIN_PATH (for example /admin-<a long random id>): any
	# other address under /admin is just a page that does not exist.
	# Optionally limit it to your own address(es) with
	# ADMIN_ALLOWED_IPS in .env (for example "203.0.113.7"); everyone else gets a plain 404. The admin has its own
	# login, rate limit and audit log either way.
	@admin_blocked {
		path {$ADMIN_PATH:/admin} {$ADMIN_PATH:/admin}/*
		not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
	}
	respond @admin_blocked 404

	# The game server: REST, WebSockets, health checks and the admin. Everything else is the web app.
	@game path /api/* /ws/* /healthz /readyz {$ADMIN_PATH:/admin} {$ADMIN_PATH:/admin}/*
	handle @game {
		request_body {
			max_size 64KB
		}
		reverse_proxy {$SERVER_UPSTREAM:server:8000} {
			# 503 for the ten seconds the game server needs to start: nobody is sent to it before it can add a CPU
			health_uri /startupz
			health_interval 2s
			health_timeout 2s
		}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000} {
			health_uri /up
			health_interval 10s
		}
	}

	log {
		output stdout
		format json
	}
}
