# Copy to /opt/hajime/.env on the server (chmod 600). Never commit the real file.
# The pipeline copies compose.prod.yml, Caddyfile.prod and deploy.sh there at every deployment, and runs
# deploy.sh with the image tag; this file is the only thing that lives on the server only.

# Public name of the site. Its DNS A/AAAA records must point to this server before the first start.
DOMAIN=hajime.yourdomain.com
# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=you@yourdomain.com
# Where the pipeline pushes the images (lowercase): ghcr.io/<github-user>/<repository>
IMAGE_PREFIX=ghcr.io/yanis-san/hajimegame

# Password of the game's PostgreSQL database (used by the server and the backups, never exposed). Generate one
# with: openssl rand -hex 24. Keep it: changing it after the first start needs a manual change inside PostgreSQL.
POSTGRES_PASSWORD=

# Optional. /metrics (Prometheus) is hidden unless this is set; then it needs "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
HAJIME_METRICS_TOKEN=
# Optional error reporting.
HAJIME_SENTRY_DSN=

# Sign-up captcha (Cloudflare Turnstile, free). Create a widget at https://dash.cloudflare.com > Turnstile for your
# domain: the SECRET goes here, the public SITE KEY goes in the GitHub variable TURNSTILE_SITE_KEY (the interface
# is built with it). Without the secret, sign-up is closed in production; guests can still play.
TURNSTILE_SECRET=

# Optional admin interface at https://<domain>/admin (browse and correct the database). Make the three values
# on your own computer with `cd apps/server && uv run python -m app.admin.passwd` and paste its three lines here.
# The hash contains "$", so keep the single quotes. Without the hash, there is no admin at all.
# HAJIME_ADMIN_USERNAME=admin
# The admin's address. Keep it long and random, e.g. /admin-3f2a9c1e-7b4d-4e8a-9c5f-1d2e3f4a5b6c (it must start
# with a lowercase letter or digit after the slash and use only a-z, 0-9, - and _). Default: /admin.
# HAJIME_ADMIN_PATH=/admin
# HAJIME_ADMIN_PASSWORD_HASH=
# HAJIME_ADMIN_SECRET=
# Optional: only these addresses may even see the admin (others get a 404). Default: everyone, behind the login.
# ADMIN_ALLOWED_IPS=203.0.113.7

# Optional. deploy.sh waits for the games in progress to end (at most this many seconds) before restarting.
DRAIN_SECONDS=180
